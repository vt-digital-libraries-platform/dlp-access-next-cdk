# Settings shared by every frontend environment. Beanstalk applies them from
# the deployed source bundle, so changing one here and deploying changes it.
#
# The environment and load balancer type aren't here: Beanstalk ignores them
# in this file when an environment is created through the API, so the
# tooling sets them at creation (lib/frontend/deploy.ts).
#
# The HTTPS listener gets its certificate from the tooling at creation.
# Managed updates run as the environment's service role, which carries the
# managed-updates policy (Api stack).
#
# Per-branch and per-backend values (certificate ARN, instance profile,
# service role, instance type, app environment variables, CNAME prefix) are
# set by the deploy tooling when an environment is created, never here.
# Conversely the tooling must never set any option below through the API or
# EB CLI: a directly applied setting takes precedence over this file and
# would freeze that option on the environment.
option_settings:
  # One instance behind the application load balancer, which terminates
  # HTTPS. Port 80 stays open; nginx redirects it to HTTPS (.platform/nginx).
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 1
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLPolicy: ELBSecurityPolicy-TLS13-1-2-2021-06
  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: true
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
  aws:elasticbeanstalk:managedactions:
    ManagedActionsEnabled: true
    PreferredStartTime: "Sun:09:00"
  aws:elasticbeanstalk:managedactions:platformupdate:
    UpdateLevel: minor
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    RetentionInDays: 7
